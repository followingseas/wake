---
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'
import '../styles/global.css'
import heroImage from '../assets/hero.png'

interface Props {
  locale: Locale
  /** 로케일 홈 기준 경로. 예: 'changelog'. 생략하면 로케일 홈을 가리킨다. */
  path?: string
  /** 생략하면 랜딩 기본값 */
  title?: string
  /** 생략하면 랜딩 기본값 */
  description?: string
}
const { locale, path, title, description } = Astro.props
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL
const pageTitle = title ?? t('meta.title')
const pageDescription = description ?? t('meta.description')
// canonical·hreflang은 같은 path를 각 로케일에 적용해야 번역 관계가 성립한다.
const canonical = getAbsoluteLocaleUrl(locale, path)
const altKo = getAbsoluteLocaleUrl('ko', path)
const altEn = getAbsoluteLocaleUrl('en', path)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={altKo} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altKo} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Wake" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={new URL(heroImage.src, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="860" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
