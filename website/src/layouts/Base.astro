---
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'
import '../styles/global.css'
import heroImage from '../assets/hero.png'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL
const canonical = getAbsoluteLocaleUrl(locale)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ko" href={getAbsoluteLocaleUrl('ko')} />
    <link rel="alternate" hreflang="en" href={getAbsoluteLocaleUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('ko')} />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Wake" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:image" content={new URL(heroImage.src, Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="860" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
