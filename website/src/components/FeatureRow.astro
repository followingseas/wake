---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
  n: 1 | 2 | 3
  image: ImageMetadata
  reverse?: boolean
}
const { locale, n, image, reverse = false } = Astro.props
const t = useTranslations(locale)
const title = t(`feature${n}.title` as 'feature1.title')
const body = t(`feature${n}.body` as 'feature1.body')
const alt = t(`feature${n}.alt` as 'feature1.alt')
---

<div class:list={['row', { reverse }]}>
  <div class="shot">
    <Image
      src={image}
      alt={alt}
      widths={[560, 800, 1200]}
      sizes="(max-width: 800px) 100vw, 560px"
    />
  </div>
  <div class="text">
    <h3>{title}</h3>
    <p set:html={body} />
  </div>
</div>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 56px;
    margin-top: 88px;
  }

  .row.reverse {
    flex-direction: row-reverse;
  }

  .shot {
    flex: 1.3;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  .text {
    flex: 1;
  }

  h3 {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }

  p {
    color: var(--text-mid);
    font-size: 15.5px;
    margin: 0;
  }

  @media (max-width: 800px) {
    .row,
    .row.reverse {
      flex-direction: column;
      gap: 24px;
      margin-top: 64px;
    }
  }
</style>
