---
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)

const items = ['local', 'terminal', 'trash', 'i18n'] as const
---

<section class="container">
  <h2>{t('grid.title')}</h2>
  <div class="grid">
    {
      items.map((item) => (
        <div class="card">
          <h3>{t(`grid.${item}.title` as 'grid.local.title')}</h3>
          <p>{t(`grid.${item}.body` as 'grid.local.body')}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  section {
    margin-top: 96px;
  }

  h2 {
    text-align: center;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0 0 32px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .card {
    background: rgba(127, 209, 219, 0.05);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px;
  }

  h3 {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  p {
    color: var(--text-dim);
    font-size: 13.5px;
    margin: 0;
  }

  @media (max-width: 800px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
