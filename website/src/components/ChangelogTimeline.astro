---
import { getCollection } from 'astro:content'
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)

/** 최신 버전이 앞에 오도록 semver 비교. */
function byVersionDesc(a: string, b: string): number {
  const pa = a.split('.').map(Number)
  const pb = b.split('.').map(Number)
  for (let i = 0; i < 3; i += 1) {
    if (pa[i] !== pb[i]) return pb[i] - pa[i]
  }
  return 0
}

// 엔트리 id는 'ko/0.6.0' 형태다 (content.config.ts 참고).
const entries = await getCollection('changelog', (entry) => entry.id.startsWith(`${locale}/`))

// 날짜가 아니라 버전으로 정렬한다 — v0.4.0과 v0.4.1처럼 같은 날 나온 릴리스가 있다.
entries.sort((a, b) => byVersionDesc(a.data.version, b.data.version))

/**
 * heading id 앞에 버전을 붙여 문서 안에서 유일하게 만든다.
 *
 * 릴리스 여덟 개가 한 페이지에 모이는데 '새 기능'·'버그 수정'은 여러 릴리스에 반복 등장하고,
 * Astro가 붙이는 자동 id는 파일 단위로만 유일하다. Astro의 heading id 생성은 사용자
 * rehype 플러그인보다 뒤에 실행되므로 플러그인으로는 손댈 수 없어 렌더 결과에서 바꾼다.
 */
function scopeHeadingIds(html: string, version: string): string {
  return html.replace(/<(h[1-6]) id="/g, `<$1 id="v${version}-`)
}

const releases = entries.map((entry) => ({
  ...entry.data,
  html: scopeHeadingIds(entry.rendered?.html ?? '', entry.data.version)
}))

// frontmatter의 date는 UTC 자정으로 파싱되므로, 포맷도 UTC로 고정해야 하루 밀리지 않는다.
const formatDate = new Intl.DateTimeFormat(locale === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
})
---

<section class="container">
  <div class="head">
    <h1>{t('changelog.title')}</h1>
    <p>{t('changelog.lede')}</p>
  </div>

  <ol class="timeline" role="list">
    {
      releases.map((release, index) => {
        const anchor = `v${release.version}`
        return (
          <li class="release" id={anchor}>
            <div class="rail">
              <h2 class="version">
                <a href={`#${anchor}`}>{release.version}</a>
              </h2>
              {index === 0 && <span class="badge">{t('changelog.latest')}</span>}
              <time datetime={release.date.toISOString().slice(0, 10)}>
                {formatDate.format(release.date)}
              </time>
            </div>
            <div class="body">
              <p class="highlight">{release.highlight}</p>
              <div class="prose" set:html={release.html} />
              <a
                class="release-link"
                href={`https://github.com/followingseas/wake/releases/tag/${anchor}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t('changelog.viewRelease')} ↗
              </a>
            </div>
          </li>
        )
      })
    }
  </ol>
</section>

<style>
  .head {
    padding-top: 48px;
  }

  h1 {
    font-size: 40px;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .head p {
    color: var(--text-mid);
    font-size: 16px;
    margin: 10px 0 0;
  }

  .timeline {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
  }

  .release {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 32px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 24px;
  }

  .release:first-child {
    border-top: none;
    padding-top: 0;
  }

  .rail {
    position: sticky;
    top: 24px;
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 7px;
  }

  .version {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .version a:hover {
    color: var(--bright);
  }

  .badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--deep);
    background: var(--bright);
    border-radius: 999px;
    padding: 2px 9px;
  }

  time {
    font-size: 13px;
    color: var(--text-dim);
  }

  .highlight {
    color: var(--text-mid);
    font-size: 16px;
    line-height: 1.55;
    margin: 0 0 18px;
  }

  .release-link {
    display: inline-block;
    margin-top: 20px;
    font-size: 13px;
    color: var(--text-dim);
    border: 1px solid var(--line);
    border-radius: 7px;
    padding: 5px 12px;
  }

  .release-link:hover {
    color: var(--foam);
    border-color: var(--bright);
  }

  /* 마크다운 렌더 결과에는 scoped 속성이 붙지 않아 :global 로 내려간다. */
  .prose :global(h3) {
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 24px 0 10px;
  }

  .prose :global(h3:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    color: var(--text-dim);
    font-size: 14.5px;
    line-height: 1.7;
    margin: 0 0 12px;
  }

  .prose :global(ul) {
    margin: 0;
    padding-left: 18px;
  }

  .prose :global(li) {
    color: var(--text-dim);
    font-size: 14.5px;
    line-height: 1.7;
    margin-bottom: 9px;
  }

  .prose :global(li:last-child) {
    margin-bottom: 0;
  }

  .prose :global(li ul) {
    margin-top: 9px;
  }

  .prose :global(strong) {
    color: var(--foam);
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--bright);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 720px) {
    .head {
      padding-top: 32px;
    }

    h1 {
      font-size: 32px;
    }

    .release {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 28px 0;
    }

    .rail {
      position: static;
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 10px;
    }
  }
</style>
