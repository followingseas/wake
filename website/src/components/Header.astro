---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
  /** 현재 페이지의 로케일 홈 기준 경로. 생략하면 홈. 언어 전환 시 같은 페이지를 유지하는 데 쓴다. */
  path?: string
}
const { locale, path } = Astro.props
const t = useTranslations(locale)
const base = import.meta.env.BASE_URL
const faviconHref = base.endsWith('/') ? `${base}favicon.svg` : `${base}/favicon.svg`
const langHref = getRelativeLocaleUrl(locale === 'ko' ? 'en' : 'ko', path)
const langLabel = locale === 'ko' ? 'EN' : 'KO'
// 홈 섹션 앵커는 절대 경로여야 한다 — 랜딩이 아닌 페이지에서 '#features'만 두면 갈 곳이 없다.
const home = getRelativeLocaleUrl(locale)
const changelogHref = getRelativeLocaleUrl(locale, 'changelog')
const onChangelog = path === 'changelog'
---

<header class="container">
  <a class="brand" href={getRelativeLocaleUrl(locale)}>
    <img src={faviconHref} alt="" width="26" height="26" />
    <span>Wake</span>
  </a>
  <nav>
    <a href={`${home}#features`}>{t('nav.features')}</a>
    <a href={`${home}#download`}>{t('nav.download')}</a>
    <a class="changelog" href={changelogHref} aria-current={onChangelog ? 'page' : undefined}
      >{t('nav.changelog')}</a
    >
    <a
      class="gh"
      href="https://github.com/followingseas/wake"
      target="_blank"
      rel="noopener noreferrer">GitHub ★</a
    >
    <a class="lang" href={langHref}>{langLabel}</a>
  </nav>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 22px;
    padding-bottom: 22px;
    position: relative;
    z-index: 2;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 800;
    font-size: 18px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    color: var(--text-mid);
  }

  nav a:hover {
    color: var(--foam);
  }

  .gh,
  .lang {
    border: 1px solid var(--line);
    padding: 6px 13px;
    border-radius: 7px;
  }

  .changelog[aria-current='page'] {
    color: var(--foam);
  }

  /* 좁은 화면에서는 홈 섹션 앵커만 접는다 — Changelog는 독립 페이지라 남긴다. */
  @media (max-width: 640px) {
    nav {
      gap: 14px;
    }

    nav a:not(.gh):not(.lang):not(.changelog) {
      display: none;
    }
  }
</style>
