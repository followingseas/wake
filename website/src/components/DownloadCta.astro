---
import type { Locale } from '../i18n/ui'
import { useTranslations } from '../i18n/ui'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const t = useTranslations(locale)
---

<section id="download" class="container">
  <h2>{t('download.title')}</h2>
  <p>{t('download.body')}</p>
  <div class="cta">
    <a
      class="btn btn-primary"
      href="https://github.com/followingseas/wake/releases/latest"
      target="_blank"
      rel="noopener noreferrer">↓ {t('hero.ctaDownload')}</a
    >
    <a
      class="btn btn-ghost"
      href="https://github.com/followingseas/wake#readme"
      target="_blank"
      rel="noopener noreferrer">{t('download.readme')}</a
    >
  </div>
</section>

<style>
  section {
    margin-top: 110px;
    text-align: center;
  }

  h2 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0;
  }

  p {
    color: var(--text-mid);
    font-size: 15px;
    margin: 12px 0 0;
  }

  .cta {
    margin-top: 26px;
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
