---
import Base from '../layouts/Base.astro'
import TopBand from '../components/TopBand.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import FeatureRow from '../components/FeatureRow.astro'
import FeatureGrid from '../components/FeatureGrid.astro'
import DownloadCta from '../components/DownloadCta.astro'
import Footer from '../components/Footer.astro'
import feature1 from '../assets/feature1.png'
import feature2 from '../assets/feature2.png'
import feature3 from '../assets/feature3.png'

---

<Base locale="ko">
  <TopBand>
    <Header locale="ko" />
    <Hero locale="ko" />
  </TopBand>
  <main>
    <div class="container" id="features">
      
      <FeatureRow locale="ko" n={1} image={feature1} />
      <FeatureRow locale="ko" n={2} image={feature2} reverse />
      <FeatureRow locale="ko" n={3} image={feature3} />
    </div>
    <FeatureGrid locale="ko" />
    <DownloadCta locale="ko" />
  </main>
  <Footer locale="ko" />
</Base>
