---
import Base from '../../layouts/Base.astro'
import TopBand from '../../components/TopBand.astro'
import Header from '../../components/Header.astro'
import Hero from '../../components/Hero.astro'
import FeatureRow from '../../components/FeatureRow.astro'
import FeatureGrid from '../../components/FeatureGrid.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Footer from '../../components/Footer.astro'
import heroImage from '../../assets/hero.png'
import settingsImage from '../../assets/settings.png'
---

<Base locale="en">
  <TopBand>
    <Header locale="en" />
    <Hero locale="en" />
  </TopBand>
  <main>
    <div class="container" id="features">
      {/* TODO: 기능별 전용 스크린샷 촬영 후 교체 (대화 클로즈업 / 사이드바 검색 / resume·fork 메뉴) */}
      <FeatureRow locale="en" n={1} image={heroImage} />
      <FeatureRow locale="en" n={2} image={heroImage} reverse />
      <FeatureRow locale="en" n={3} image={settingsImage} />
    </div>
    <FeatureGrid locale="en" />
    <DownloadCta locale="en" />
  </main>
  <Footer locale="en" />
</Base>
