---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import ChangelogTimeline from '../../components/ChangelogTimeline.astro'
import DownloadCta from '../../components/DownloadCta.astro'
import Footer from '../../components/Footer.astro'
import { useTranslations } from '../../i18n/ui'

const t = useTranslations('en')
---

<Base
  locale="en"
  path="changelog"
  title={t('changelog.metaTitle')}
  description={t('changelog.metaDescription')}
>
  <Header locale="en" path="changelog" />
  <main>
    <ChangelogTimeline locale="en" />
    <DownloadCta locale="en" />
  </main>
  <Footer locale="en" />
</Base>
