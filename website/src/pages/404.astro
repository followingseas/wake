---
import Base from '../layouts/Base.astro'
import { useTranslations } from '../i18n/ui'

const t = useTranslations('ko')
const tEn = useTranslations('en')
const base = import.meta.env.BASE_URL
---

<Base locale="ko">
  <main class="container">
    <h1>404</h1>
    <p>{t('notfound.title')} · {tEn('notfound.title')}</p>
    <a class="btn btn-ghost" href={base}>{t('notfound.home')} · {tEn('notfound.home')}</a>
  </main>
</Base>

<style>
  main {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
  }

  h1 {
    font-size: 64px;
    font-weight: 800;
    margin: 0;
    color: var(--bright);
  }

  p {
    color: var(--text-mid);
    margin: 0 0 12px;
  }
</style>
